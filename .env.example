# App Thi Online — env
# Copy sang .env và điền giá trị thật

# Supabase (cùng project với TTDT hoặc project riêng)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 1 = COCO-SSD (điện thoại/sách/laptop) + BlazeFace. 0 = chỉ BlazeFace (mặt / nhiều người)
VITE_AI_PROCTORING_ENABLED=0

# Hiển thị tính năng đồng bộ TTDT (không chứa bí mật)
VITE_TTDT_SYNC_ENABLED=1

# ─── Serverless proxy env vars (đặt trong Vercel Dashboard, KHÔNG dùng VITE_ prefix) ───
# POTENTIAL_STUDENT_API_KEY=...  (cùng giá trị với chatbot — cho proxy /api/scan-id-card)
# SUPABASE_URL=...               (optional, fallback sang VITE_SUPABASE_URL nếu không set)
# SUPABASE_SERVICE_ROLE_KEY=...  (chỉ cho /api/sync-ttdt, tuyệt đối không dùng VITE_ prefix)
# TTDT_RECEIVE_GRADES_URL=...    (endpoint receive-exam-results)
# TTDT_VERIFY_CCCD_URL=...       (endpoint verify-cccd-for-exam)
# TTDT_API_KEY=...               (API key TTDT dùng để gửi điểm)
# QUESTION_IMPORT_WORKER_URL=...  (Python/Docker container URL; no VITE_ prefix)
# QUESTION_IMPORT_WORKER_TOKEN=... (shared Vercel and worker secret)
# VITE_DOCUMENT_IMPORT_ENABLED=0  (set to 1 only after a worker health check)

# ─── Dev local override (không cần trên Vercel) ───
# Các API OCR, xác thực CCCD và đồng bộ điểm đều đi qua proxy Vercel để khóa API không xuất hiện trong trình duyệt.
